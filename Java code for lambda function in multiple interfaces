interface Addition {
    int add(int a, int b);
}
interface Subtraction {
    int sub(int a, int b);
}
interface Multiplication {
    int mul(int a, int b);
}
interface Division {
    int div(int a, int b);
}
public class LambdaFunctionJava8 {
public static void main(String[] args) {
       Addition add = (a, b) -> a + b;
       Subtraction sub = (a, b) -> a - b;
       Multiplication mul = (a, b) -> a * b;
       Division div = (a, b) -> a / b;
       System.out.println("Addition: " + add.add(10, 5));
       System.out.println("Subtraction: " + sub.sub(10, 5));
       System.out.println("Multiplication: " + mul.mul(10, 5));
       System.out.println("Division: " + div.div(10, 5));
    }
}
