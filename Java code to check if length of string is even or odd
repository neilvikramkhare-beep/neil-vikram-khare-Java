public class LengthOfString {
    public static void main(String[] args) {
        String s = "dgshadgsahhdhasgdsahdhasy";
        int l = s.length();
        System.out.println("Length of string:"+l);
        if(l%2==0)
        {
            System.out.println("Length is even.");
        }
        else
        {
            System.out.println("Length is odd.");
        }
    }
}
