@FunctionalInterface
interface MyFunctionalInterface {
    int add(int a, int b);
}
public class FunctionalInterface {
    public static void main(String[] args) {
        MyFunctionalInterface myFunc = (a, b) -> a + b;
        int result = myFunc.add(5, 10);
        System.out.println("The sum is: " + result); 
    }
}
