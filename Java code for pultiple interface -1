interface Animal
{ 
    void sound(); 
} 
class Dog implements Animal 
{ 
    public void sound()
    { 
        System.out.println("Dog barks."); 
    } 
    public void display() 
    { 
        System.out.println("Dog details."); 
    } 
} 
class Main 
{ 
    public static void main(String args[])
    { 
        Animal a = new Dog(); 
        a.sound(); 
        Dog d = new Dog(); 
        d.display(); 
    } 
}
