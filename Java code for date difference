public class TwoDateDifference {
    public static void main(String[] args) {
        String date1 = "2023-01-01";
        String date2 = "2023-01-15";
        int difference = calculateDateDifference(date1, date2);
        System.out.println("Difference in days: " + difference);
    }
    public static int calculateDateDifference(String date1, String date2) {
        java.time.LocalDate d1 = java.time.LocalDate.parse(date1);
        java.time.LocalDate d2 = java.time.LocalDate.parse(date2);
        return (int) java.time.temporal.ChronoUnit.DAYS.between(d1, d2);
    }
}
