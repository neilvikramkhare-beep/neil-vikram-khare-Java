class Animal
{
    void eat()
    {
        System.out.println("Dog eats.");
    }
}
class Dog extends Animal
{
    void bark()
    {
        System.out.println("Dog barks.");
    }
}
class Puppy extends Dog
{
    void sleep()
    {
        System.out.println("Dog sleeps.");
    }
}
public class Main
{
public static void main(String args[])
{
    Animal a = new Animal();
    a.eat();
    Dog d = new Dog();
    d.bark();
    Puppy p = new Puppy();
    p.sleep();
}
}
